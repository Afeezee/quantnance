# Quantnance frontend — PRODUCTION env vars
#
# These values must be set in the Vercel dashboard for the frontend project
# (Project Settings → Environment Variables, scope: Production). Vercel will
# bake them into the Vite build at `vercel build` time — do NOT commit real
# values to this file.
#
# For local development, keep using client/.env.example / client/.env
# (which point VITE_API_URL at http://localhost:8000).

# Public origin of the deployed backend Vercel project. No trailing slash.
# Example: https://quantnance-api.vercel.app
VITE_API_URL=https://your-backend-project.vercel.app

# Clerk publishable key (production instance, not the dev one).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_production_key_here
